{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pluginrpc.dev/spec/prpc-1/response.json",
  "title": "Response",
  "description": "One response from the plugin, discriminated by result or error, with exactly one present. The result schema belongs to the profile.",
  "type": "object",
  "$defs": {
    "id": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  },
  "oneOf": [
    {
      "title": "Success",
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "not": { "required": ["error"] },
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": {}
      },
      "additionalProperties": false
    },
    {
      "title": "Failure",
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "not": { "required": ["result"] },
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "additionalProperties": false,
          "properties": {
            "code": { "type": "integer" },
            "message": { "type": "string" },
            "data": {}
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
