{
  "description": "The same table drives crates/plugin-rpc-conformance/tests/profile_spec.rs (the reference loader) and scripts/check_profile_schema.py (the committed meta-schema). A rule the meta-schema enforces and the loader does not shows up there; a rule the loader enforces and the meta-schema does not shows up here.",
  "cases": [
    {
      "name": "demo-ok",
      "expect": "accept",
      "document": {
        "mechanism": "prpc/1",
        "protocolVersion": "demo/1",
        "manifest": "demo.json",
        "methods": {
          "ping": {
            "params": "schema/ping-req.json",
            "result": "schema/ping.json"
          },
          "coverageMap": {
            "result": "schema/coverage.json",
            "requiresCapability": "sideEffects"
          }
        },
        "capabilities": {
          "sideEffects": {
            "ifAbsent": "the host applies no side-effect policy"
          }
        },
        "loss": {
          "mapping": {
            "spawn": "none",
            "eof": "none",
            "exited": "none",
            "killed": "none",
            "noAnswer": "none"
          }
        },
        "conformance": {
          "suite": [
            "/bin/sh",
            "suite.sh"
          ],
          "rules": [
            {
              "id": "ping-schema",
              "expectation": "ping answers its schema.",
              "defect": {
                "run": [
                  "/bin/sh",
                  "plugin.sh"
                ],
                "env": [
                  "DEMO=1"
                ],
                "expectViolation": [
                  "ping-schema"
                ]
              }
            },
            {
              "id": "ping-twice",
              "expectation": "ping twice answers the same.",
              "dependsOn": [
                "ping-schema"
              ],
              "defect": {
                "unverified": "the reference plugin cannot answer twice differently."
              }
            }
          ]
        }
      }
    },
