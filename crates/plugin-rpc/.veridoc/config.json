{
  "protocol": "veridoc/1",
  "plugin": {
    "name": "veridoc-plugin-rust"
  },
  "coverage": {
    "required": 0.0
  },
  "run": {
    "scenarioDeadlineMs": 30000
  },
  "judge": {
    "transport": "command",
    "command": [
      "python3",
      "tools/scripted-judge.py"
    ],
    "model": "scripted-1",
    "promptVersion": "veridoc-prompt-1",
    "timeoutMs": 120000
  },
  "output": {
    "dir": ".veridoc/out",
    "formatters": [
      "markdown"
    ]
  },
  "citationStores": []
}
