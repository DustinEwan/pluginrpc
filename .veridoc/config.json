{
  "protocol": "veridoc/1",
  "plugin": {
    "name": "veridoc-plugin-rust",
    "command": null,
    "handshakeTimeoutMs": 30000,
    "collectTimeoutMs": 120000
  },
  "coverage": {
    "required": 0.0
  },
  "run": {
    "scenarioDeadlineMs": 30000
  },
  "judge": {
    "provider": "openai",
    "model": "localcoder",
    "baseUrl": "${VERIDOC_JUDGE_BASE_URL}",
    "apiKeyEnv": "RADIANCE_API_KEY"
  },
  "output": {
    "dir": "./docs",
    "formatters": [
      "markdown"
    ]
  },
  "citationStores": []
}
